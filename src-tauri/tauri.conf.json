{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RTSP Viewer",
  "version": "0.1.0",
  "identifier": "com.firebadnofire.rtspviewer",
  "mainBinaryName": "RTSP Viewer",
  "build": {
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "beforeDevCommand": "npm --prefix ../ui run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RTSP Viewer",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
